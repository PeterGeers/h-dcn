# API Configuration
REACT_APP_API_BASE_URL=https://your-api-gateway-url.execute-api.region.amazonaws.com/prod

# AWS Cognito Configuration  
REACT_APP_USER_POOL_ID=your-user-pool-id
REACT_APP_USER_POOL_WEB_CLIENT_ID=your-app-client-id
REACT_APP_COGNITO_DOMAIN=your-cognito-domain.auth.region.amazoncognito.com
REACT_APP_AWS_REGION=eu-west-1

# NOTE: REACT_APP_AWS_ACCESS_KEY_ID / REACT_APP_AWS_SECRET_ACCESS_KEY were
# removed. They are not read anywhere in frontend/src, and any REACT_APP_* var
# is inlined into the public JS bundle at build time — so static IAM keys there
# would be exposed to every visitor. Cognito admin / user management runs
# through the backend API (protected Lambdas), not browser-side AWS SDK calls.