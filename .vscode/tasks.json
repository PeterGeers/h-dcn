{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check AuthLayer Sync",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "main='backend/shared/auth_utils.py'; layer='backend/layers/auth-layer/python/shared/auth_utils.py'; echo 'Checking AuthLayer file synchronization...'; if [ -f \"$main\" ] && [ -f \"$layer\" ]; then if cmp -s \"$main\" \"$layer\"; then echo '✅ AuthLayer files are in sync'; else echo '⚠️  AuthLayer files are OUT OF SYNC!'; echo \"Main file:  $main\"; echo \"Layer file: $layer\"; echo \"Run: cp $main $layer\"; fi; else echo '❌ One or both AuthLayer files are missing'; fi"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Sync AuthLayer Files",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "echo 'Syncing AuthLayer files...'; cp backend/shared/auth_utils.py backend/layers/auth-layer/python/shared/auth_utils.py && echo '✅ AuthLayer files synchronized'"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Git Status with Critical Files",
      "type": "shell",
      "command": "git",
      "args": [
        "status",
        "--porcelain",
        "backend/shared/auth_utils.py",
        "backend/layers/auth-layer/python/shared/auth_utils.py",
        "backend/template.yaml",
        "frontend/.env",
        "backend/samconfig.toml"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Show Recent Changes to Critical Files",
      "type": "shell",
      "command": "git",
      "args": [
        "log",
        "--oneline",
        "-10",
        "--",
        "backend/shared/auth_utils.py",
        "backend/layers/auth-layer/python/shared/auth_utils.py",
        "backend/template.yaml",
        "scripts/deployment/"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}